# ==============================================================================
# Database Configuration (Supabase PostgreSQL / Drizzle ORM)
# ==============================================================================
# The application connects to PostgreSQL via Drizzle ORM & pg.Pool.
# Configure ONE of the following PostgreSQL connection strings:
#
# Option A: Supabase Connection Pooler (Recommended for Vercel / serverless):
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Transaction, Port 6543)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Option B: Supabase Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
#
# Option C: Vercel-Supabase Integration auto-generated variable:
# POSTGRES_URL="postgresql://..."
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/visibility_db"

# Optional: Supabase HTTP Client & Auth keys (if using Supabase Auth / JS SDK)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
